# Réglages de docker compose. Copiez ce fichier en .env puis remplissez-le.
# Toutes les variables sont facultatives.

# Port publié sur la machine hôte, et adresse d'écoute.
# Derrière un proxy inverse sur la même machine, mettez MERIZ_BIND=127.0.0.1.
MERIZ_PORT=8080
MERIZ_BIND=0.0.0.0

# Origine du serveur Meriz API, sans /api ni barre finale.
# Vide : comptes désactivés, documents gardés dans le navigateur.
# MERIZ_API_URL=https://api.meriz.exemple.fr
MERIZ_API_URL=

# Direct (websocket Reverb). La clé est publique.
# Ne mettez jamais REVERB_APP_SECRET ici.
# MERIZ_REVERB_APP_KEY=la-cle-publique-de-votre-application-reverb
# MERIZ_REVERB_HOST=direct.meriz.exemple.fr
# MERIZ_REVERB_PORT=443
# MERIZ_REVERB_SCHEME=https
MERIZ_REVERB_APP_KEY=
MERIZ_REVERB_HOST=
MERIZ_REVERB_PORT=
MERIZ_REVERB_SCHEME=
