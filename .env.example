# Adresse du serveur Meriz API : son origine, sans /api ni barre finale.
# Le développement utilise .env.development (serveur local).
# Pour un build en ligne, créez .env.production.local avec l'adresse réelle.
# Variable vide ou absente : les comptes sont désactivés, et Meriz
# reste utilisable sans compte, documents gardés dans le navigateur.
# VITE_API_URL=https://api.meriz.exemple.fr
VITE_API_URL=

# Serveur de direct (websocket Reverb), pour l'observation d'un travail
# en cours. En local, `php artisan reverb:start` dans le dépôt meriz-api
# écoute sur le port 8080 ; en ligne, c'est le domaine public en https,
# port 443. La clé est publique : elle circule dans le navigateur et
# n'autorise rien à elle seule, chaque canal étant autorisé au jeton du
# compte. Ne mettez jamais REVERB_APP_SECRET ici.
# Variables vides ou absentes : l'observation garde son rafraîchissement
# régulier, sans rien changer d'autre.
# VITE_REVERB_APP_KEY=la-cle-publique-de-votre-application-reverb
# VITE_REVERB_HOST=direct.meriz.exemple.fr
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
