# Réglages de `npm run dev` (fichier commité, aucune donnée secrète).
# Origine du serveur Meriz API en local, sans /api : lancez-le avec
# `php artisan serve` dans le dépôt meriz-api.
VITE_API_URL=http://127.0.0.1:8000

# Serveur de direct (websocket), lancé par `php artisan reverb:start`
# dans le même dépôt. La clé est publique par nature : elle circule dans
# le navigateur, et n'autorise rien à elle seule. Les canaux restent
# autorisés un par un, au jeton du compte.
# Réglages absents : l'observation retombe sur son rafraîchissement
# régulier, et rien d'autre ne change.
VITE_REVERB_APP_KEY=ee142beb7f42d7e514f701a33b1aa91b
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
